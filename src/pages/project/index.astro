---
import { getAllProjectPosts } from '../../lib/sanity';
import { urlFor } from '../../lib/urlFor';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getAllProjectPosts();

const grouped = posts.reduce(
	(acc, post) => {
		const slug = post.projectSlug;
		if (!slug) return acc;
		if (!acc[slug]) acc[slug] = [];
		acc[slug].push(post);
		return acc;
	},
	{} as Record<string, typeof posts>,
);

const projects = Object.entries(grouped)
	.map(([slug, projectPosts]) => {
		const sortedPosts = [...projectPosts].sort(
			(a, b) => new Date(b.pubDate).valueOf() - new Date(a.pubDate).valueOf(),
		);
		const coverPost = sortedPosts.find((p) => p.heroImage) ?? sortedPosts[0];
		const descriptionPost = sortedPosts.find(
			(p) => p.description && p.description.trim().length > 0,
		);
		const latestPost = sortedPosts[0];

		return {
			slug,
			name: slug,
			posts: sortedPosts,
			postCount: sortedPosts.length,
			coverImage: coverPost?.heroImage,
			description: descriptionPost?.description?.trim() ?? '',
			latestPost,
		};
	})
	.sort(
		(a, b) =>
			new Date(b.latestPost.pubDate).valueOf() - new Date(a.latestPost.pubDate).valueOf(),
	);

const recentUpdates = posts.slice(0, 8);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} | Projects`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1080px, calc(100% - 2rem));
				padding-inline: 0;
			}
			section + section {
				margin-top: 3rem;
			}
			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.section-head h1,
			.section-head h2 {
				margin: 0;
			}
			.section-head p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.project-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.2rem;
			}
			.project-grid > li {
				min-width: 0;
			}
			.project-card {
				display: grid;
				grid-template-rows: auto 1fr;
				width: 100%;
				min-width: 0;
				text-decoration: none;
				color: inherit;
				background: rgba(255, 255, 255, 0.88);
				border: 1px solid rgba(var(--gray-light), 0.8);
				border-radius: 16px;
				overflow: hidden;
				box-shadow: 0 4px 18px rgba(var(--gray), 0.08);
				transition:
					transform 0.18s ease,
					box-shadow 0.18s ease,
					border-color 0.18s ease;
			}
			.project-card:hover {
				transform: translateY(-3px);
				box-shadow: 0 14px 28px rgba(var(--gray), 0.18);
				border-color: rgba(var(--accent), 0.28);
			}
			.project-image {
				aspect-ratio: 16 / 10;
				background:
					radial-gradient(circle at center, rgba(var(--accent), 0.12), transparent 60%),
					rgba(var(--gray-light), 0.35);
				display: grid;
				place-items: center;
				padding: 1rem;
				box-sizing: border-box;
				min-width: 0;
				overflow: hidden;
			}
			.project-image img {
				display: block;
				width: 60%;
				height: auto;
				max-width: 60%;
				object-fit: contain;
				border-radius: 12px;
			}
			.project-body {
				min-width: 0;
				padding: 1rem 1rem 1.1rem;
				display: grid;
				gap: 0.55rem;
			}
			.project-meta {
				margin-top: 0.1rem;
			}
			.project-count {
				display: inline-block;
				font-size: 0.9rem;
				font-weight: 600;
				color: rgb(var(--gray));
			}
			.pill {
				display: inline-flex;
				align-items: center;
				padding: 0.18rem 0.5rem;
				border-radius: 999px;
				background: rgba(var(--accent), 0.08);
				color: rgb(var(--accent-dark));
				font-weight: 600;
			}
			.project-title {
				margin: 0;
				font-size: 1.35rem;
				line-height: 1.25;
				color: rgb(var(--black));
			}
			.project-desc {
				margin: 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95rem;
				line-height: 1.55;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.project-desc.is-empty {
				color: rgb(var(--gray));
			}
			.recent-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.8rem;
			}
			.recent-item a {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 0.75rem;
				align-items: center;
				padding: 0.9rem 1rem;
				border-radius: 14px;
				border: 1px solid rgba(var(--gray-light), 0.85);
				background: rgba(255, 255, 255, 0.82);
				text-decoration: none;
				color: inherit;
				transition:
					border-color 0.18s ease,
					box-shadow 0.18s ease;
			}
			.recent-item a:hover {
				border-color: rgba(var(--accent), 0.26);
				box-shadow: 0 10px 22px rgba(var(--gray), 0.12);
			}
			.recent-main {
				display: grid;
				gap: 0.3rem;
				min-width: 0;
			}
			.recent-main h3 {
				margin: 0;
				font-size: 1rem;
				line-height: 1.3;
			}
			.recent-sub {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				min-width: 0;
				color: rgb(var(--gray));
				font-size: 0.88rem;
			}
			.recent-date {
				color: rgb(var(--gray));
				font-size: 0.9rem;
				white-space: nowrap;
			}
			.recent-project {
				font-weight: 600;
				color: rgb(var(--accent-dark));
				background: rgba(var(--accent), 0.08);
				padding: 0.1rem 0.45rem;
				border-radius: 999px;
			}
			.empty-state {
				margin: 0;
				padding: 1rem;
				border: 1px dashed rgb(var(--gray-light));
				border-radius: 12px;
				color: rgb(var(--gray));
				background: rgba(255, 255, 255, 0.75);
			}
			@media (max-width: 720px) {
				main {
					width: calc(100% - 1.25rem);
				}
				.section-head {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.35rem;
				}
				.recent-item a {
					grid-template-columns: 1fr;
					gap: 0.5rem;
				}
				.recent-date {
					white-space: normal;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="section-head">
					<h1>Projects</h1>
					<p>{projects.length} projects</p>
				</div>
				{
					projects.length > 0 ? (
						<ul class="project-grid">
							{projects.map((project) => (
								<li>
									<a class="project-card" href={`/project/${project.slug}/`}>
										<div class="project-image">
											{project.coverImage ? (
												<img
													src={urlFor(project.coverImage).width(320).height(200).fit('crop').url()}
													width="320"
													alt=""
												/>
											) : (
												<span class="pill">No image</span>
											)}
										</div>
										<div class="project-body">
											<h2 class="project-title">{project.name}</h2>
											<p
												class:list={[
													'project-desc',
													{ 'is-empty': project.description.length === 0 },
												]}
											>
												{project.description || 'No description yet.'}
											</p>
											<div class="project-meta">
												<span class="project-count">{project.postCount} posts</span>
											</div>
										</div>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="empty-state">No project posts found.</p>
					)
				}
			</section>

			<section>
				<div class="section-head">
					<h2>최근 업데이트</h2>
				</div>
				{
					recentUpdates.length > 0 ? (
						<ul class="recent-list">
							{recentUpdates.map((post) => (
								<li class="recent-item">
									<a href={`/project/${post.projectSlug}/${post.postSlug.current}/`}>
										<div class="recent-main">
											<h3>{post.title}</h3>
											<div class="recent-sub">
												<span class="recent-project">{post.projectSlug}</span>
												{post.description && <span>{post.description}</span>}
											</div>
										</div>
										<div class="recent-date">
											<FormattedDate date={new Date(post.pubDate)} />
										</div>
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="empty-state">No recent updates yet.</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
