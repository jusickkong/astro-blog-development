---
import { getAllThoughts, getThought } from '../../lib/sanity';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PortableText from '../../components/PortableText.astro';

export async function getStaticPaths() {
	const thoughts = await getAllThoughts();
	return thoughts.map((thought) => ({
		params: { slug: thought.slug.current },
		props: { slug: thought.slug.current },
	}));
}

type Props = { slug: string };

const { slug } = Astro.props;
const thought = await getThought(slug);

if (!thought) return Astro.redirect('/thoughts/');

const { title, description, metaDescription, pubDate, updatedDate, body } = thought;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description ?? title} metaDescription={metaDescription} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				margin: 1rem 0 0 1rem;
				color: rgb(var(--gray));
				text-decoration: none;
				font-size: 0.92rem;
			}
			.back-link:hover {
				color: rgb(var(--accent-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<h1>{title}</h1>
						<div class="date">
							<FormattedDate date={new Date(pubDate)} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={new Date(updatedDate)} />
									</div>
								)
							}
						</div>
						<hr />
					</div>
					{body && <PortableText value={body} />}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
