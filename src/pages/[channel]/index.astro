---
import { getAllArticles } from '../../lib/sanity';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CHANNELS, SITE_TITLE } from '../../consts';

export function getStaticPaths() {
	// 글이 없는 채널도 헤더 링크가 404가 되지 않도록 항상 생성한다.
	return CHANNELS.map((channel) => ({ params: { channel: channel.value }, props: { channel } }));
}

const { channel } = Astro.props;
const posts = (await getAllArticles()).filter((post) => post.channel === channel.value);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${SITE_TITLE} | ${channel.title}`} description={channel.description} />
		<style>
			main {
				width: min(720px, calc(100% - 2rem));
				padding-inline: 0;
			}
			.page-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1.5rem;
			}
			.page-head h1 {
				margin: 0;
			}
			.page-head p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.9rem;
			}
			.post-item a {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 1rem;
				align-items: center;
				padding: 1rem 1.1rem;
				border-radius: 14px;
				border: 1px solid rgba(var(--gray-light), 0.85);
				background: rgba(255, 255, 255, 0.84);
				color: inherit;
				text-decoration: none;
				transition:
					border-color 0.18s ease,
					box-shadow 0.18s ease;
			}
			.post-item a:hover {
				border-color: rgba(var(--accent), 0.26);
				box-shadow: 0 10px 22px rgba(var(--gray), 0.12);
			}
			.post-main h2 {
				margin: 0 0 0.3rem;
				font-size: 1.1rem;
				line-height: 1.3;
			}
			.post-main p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.92rem;
				line-height: 1.45;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.post-date {
				color: rgb(var(--gray));
				font-size: 0.9rem;
				white-space: nowrap;
			}
			.empty-state {
				margin: 0;
				padding: 1rem;
				border: 1px dashed rgb(var(--gray-light));
				border-radius: 12px;
				color: rgb(var(--gray));
				background: rgba(255, 255, 255, 0.75);
			}
			@media (max-width: 720px) {
				main {
					width: calc(100% - 1.25rem);
				}
				.post-item a {
					grid-template-columns: 1fr;
					gap: 0.4rem;
				}
				.post-date {
					white-space: normal;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-head">
				<h1>{channel.title}</h1>
				<p>{posts.length} posts</p>
			</div>
			{
				posts.length > 0 ? (
					<ul class="post-list">
						{posts.map((post) => (
							<li class="post-item">
								<a href={`/${channel.value}/${post.slug.current}/`}>
									<div class="post-main">
										<h2>{post.title}</h2>
										{post.description && <p>{post.description}</p>}
									</div>
									<div class="post-date">
										<FormattedDate date={new Date(post.pubDate)} />
									</div>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="empty-state">아직 작성된 글이 없습니다.</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>
