# Sanity CMS 설정
# sanity.io에서 프로젝트 생성 후 아래 값들을 채워주세요.

# Sanity 프로젝트 ID (sanity.io/manage에서 확인)
PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# 데이터셋 이름 (기본값: production)
PUBLIC_SANITY_DATASET=production

# Sanity API 토큰 (마이그레이션 스크립트 및 서버사이드 전용)
# Sanity Studio > Settings > API > Tokens 에서 Editor 권한으로 생성
# ⚠️  PUBLIC_ 접두사 없음 - 클라이언트에 노출되면 안 됨
SANITY_API_TOKEN=your_api_token_here

# 글 작성 에이전트 (agent/agent.py)
# OpenAI 호환 엔드포인트. 툴콜을 지원하는 모델이어야 함
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=your_model_here

# 승인 요청 메일. Gmail은 계정 비밀번호가 아니라 앱 비밀번호를 쓴다
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFY_TO=you@gmail.com
