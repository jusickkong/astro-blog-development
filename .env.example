# Sanity CMS 설정
# sanity.io에서 프로젝트 생성 후 아래 값들을 채워주세요.

# Sanity 프로젝트 ID (sanity.io/manage에서 확인)
PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# 데이터셋 이름 (기본값: production)
PUBLIC_SANITY_DATASET=production

# Sanity API 토큰 (마이그레이션 스크립트 및 서버사이드 전용)
# Sanity Studio > Settings > API > Tokens 에서 Editor 권한으로 생성
# ⚠️  PUBLIC_ 접두사 없음 - 클라이언트에 노출되면 안 됨
SANITY_API_TOKEN=your_api_token_here
