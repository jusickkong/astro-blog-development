{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*-privacy-.*)",
      "dest": "/$1"
    },
    {
      "src": "/app-ads.txt",
      "dest": "/app-ads.txt"
    },
    {
      "src": "/serise/calculator.json",
      "dest": "/calculator.json"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
